# FUTURE TEMPLATE ONLY. Never apply while the Hiper M change freeze is active.
# All sensitive values must be supplied privately in a separate server-side file.
APP_NAME="FinAI Ledger API"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.e-integrator.si
APP_KEY=
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
SESSION_DRIVER=file
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=.e-integrator.si
SANCTUM_STATEFUL_DOMAINS=app.e-integrator.si,api.e-integrator.si
FINAI_ALLOWED_ORIGINS=https://app.e-integrator.si
FINAI_AUTH_RELEASE_ENABLED=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_LEVEL=warning
# Frontend build variable, set separately only after the domain is approved:
# NEXT_PUBLIC_FINAI_API_BASE_URL=https://api.e-integrator.si/api
