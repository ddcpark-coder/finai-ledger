APP_NAME="FinAI Ledger API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=sl
APP_FALLBACK_LOCALE=en

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_DOMAIN=

CACHE_STORE=file
QUEUE_CONNECTION=sync

SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
FINAI_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production remains locked until verified 2FA/CSRF/Hiper M release.
FINAI_AUTH_RELEASE_ENABLED=false

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Domain selected on 2026-11-04: e-integrator.si
# DEVELOPMENT ON SHARED HIPER M: synthetic data only; do not enable public login.
# These are EXAMPLES for a future dedicated .env, not active settings.
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://api.e-integrator.si
# APP_KEY=<generate securely on server; never commit>
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_DATABASE=<new FinAI-only database>
# DB_USERNAME=<FinAI-only database user>
# DB_PASSWORD=<server secret>
# SESSION_SECURE_COOKIE=true
# SESSION_DOMAIN=.e-integrator.si
