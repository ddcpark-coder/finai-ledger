APP_NAME="FinAI Ledger API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=sl
APP_FALLBACK_LOCALE=en

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_DOMAIN=

CACHE_STORE=file
QUEUE_CONNECTION=sync

SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
FINAI_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Deployment: Hiper M - never commit real credentials or secrets.
# APP_ENV=production, APP_DEBUG=false, APP_KEY=<generated on server>
# DB_CONNECTION=mysql, DB_HOST=..., DB_DATABASE=..., DB_USERNAME=..., DB_PASSWORD=...
# SESSION_SECURE_COOKIE=true
# SESSION_DOMAIN=.finai.si
# SANCTUM_STATEFUL_DOMAINS=app.finai.si,api.finai.si
# FINAI_ALLOWED_ORIGINS=https://app.finai.si
